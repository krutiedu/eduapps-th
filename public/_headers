# Cloudflare Pages _headers — ตั้งค่า cache
# วางไฟล์นี้ที่ public/_headers

# รูปภาพ + ไอคอน — cache 30 วัน
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000

# Manifest + robots — cache 1 วัน
/site.webmanifest
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400

# HTML — ไม่ cache นาน (เพราะอัปเดตบ่อย) แต่ให้ revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# หน้า admin — ไม่มีเลขเวอร์ชันในชื่อไฟล์ ถ้าไม่ตั้งตรงนี้จะตกไปใช้ Browser Cache TTL
# 4 ชั่วโมงของ Cloudflare → แก้หน้า admin แล้ว deploy แต่ยังเห็นของเก่า (เคยเจอมาแล้ว)
/admin/
  Cache-Control: public, max-age=0, must-revalidate
/admin/index.html
  Cache-Control: public, max-age=0, must-revalidate
/board/
  Cache-Control: public, max-age=0, must-revalidate
/board/index.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS/JS ของเว็บหลัก — แยกออกจาก index.html แล้ว จึง cache ได้
# ใช้ must-revalidate เหมือน HTML เพราะยังไม่มีเลขเวอร์ชันในชื่อไฟล์
# (ถ้า cache นานแล้ว deploy ใหม่ ผู้ใช้จะได้โค้ดเก่าค้าง)
/app.css
  Cache-Control: public, max-age=0, must-revalidate
/app.js
  Cache-Control: public, max-age=0, must-revalidate

# Security headers — ใช้ได้ทุกหน้า
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
